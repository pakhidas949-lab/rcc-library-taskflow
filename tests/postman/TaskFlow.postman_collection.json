              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Route error is reported', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error.message).to.include('Route not found');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unexpected Error - 500 Internal Server Error",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/_debug/error",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "_debug",
                "error"
              ]
            },
            "description": "Debug-only endpoint used to prove the error middleware returns a clean 500 envelope. It is disabled when NODE_ENV=production."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 500', function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "",
                  "pm.test('Response is still valid JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test('Error envelope is well formed', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "    pm.expect(jsonData.error.message).to.be.a('string');",
                  "    pm.expect(jsonData.requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
