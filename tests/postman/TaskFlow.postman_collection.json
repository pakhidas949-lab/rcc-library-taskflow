    {
      "name": "2. Task Creation",
      "item": [
        {
          "name": "Create Task - Valid Payload (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"text\": \"Write the TaskFlow API documentation\",\n    \"completed\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            },
            "description": "Creates a task and stores the new id in the `taskId` collection variable for later requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has JSON body', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test('Task object has the expected shape', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "    pm.expect(jsonData.data.id).to.be.a('number');",
                  "    pm.expect(jsonData.data.text).to.be.a('string');",
                  "    pm.expect(jsonData.data.completed).to.be.a('boolean');",
                  "    pm.expect(jsonData.data.createdAt).to.be.a('string');",
                  "    pm.expect(jsonData.data.updatedAt).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Task text is trimmed', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.text).to.eql('Write the TaskFlow API documentation');",
                  "});",
                  "",
                  "pm.test('Location header points at the new task', function () {",
                  "    pm.expect(pm.response.headers.get('Location')).to.include('/api/tasks/');",
                  "});",
                  "",
                  "// Hand the id over to the rest of the collection.",
                  "const jsonData = pm.response.json();",
                  "pm.collectionVariables.set('taskId', jsonData.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Task - Missing Text (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"completed\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            },
            "description": "Validation failure - `text` is mandatory."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error envelope is well formed', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "    pm.expect(jsonData.error).to.be.an('object');",
                  "    pm.expect(jsonData.error.message).to.be.a('string');",
                  "    pm.expect(jsonData.error.details).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('The text field is reported as invalid', function () {",
                  "    const jsonData = pm.response.json();",
                  "    const field = jsonData.error.details.find(function (d) { return d.field === 'text'; });",
                  "    pm.expect(field).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Task - Blank Text (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"text\": \"   \"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
