                  "});",
                  "",
                  "pm.test('Message mentions the required text', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error.message).to.eql('Validation failed');",
                  "    const field = jsonData.error.details.find(function (d) { return d.field === 'text'; });",
                  "    pm.expect(field).to.not.be.undefined;",
                  "    pm.expect(field.message.toLowerCase()).to.include('text');",
                  "});"
                ]
              }
            }
