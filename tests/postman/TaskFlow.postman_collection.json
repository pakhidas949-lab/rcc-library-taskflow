{
  "info": {
    "_postman_id": "3f7a2c10-9b41-4e8a-9d55-taskflowapi01",
    "name": "TaskFlow API v1",
    "description": "Complete Postman test suite for the TaskFlow REST API.\n\nCovers every endpoint:\n1. Health check\n2. Task creation (valid + invalid payloads)\n3. Task retrieval (list, single, filters)\n4. Task update (partial + full)\n5. Task deletion\n6. Error handling (400 / 404 / 500)\n\nImport the matching environment file (TaskFlow Local) and run the collection with `npm run test:postman` or directly in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "1",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Stamp every request with a unique id so server logs can be correlated.",
          "pm.request.headers.add('X-Request-Id', 'pm-' + Date.now() + '-' + Math.floor(Math.random() * 1000));",
          "if (!pm.collectionVariables.get('baseUrl')) {",
          "    pm.collectionVariables.set('baseUrl', 'http://localhost:5000');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Session - Anonymous",
          "request": {
            "method": "GET",
            "header": [],
